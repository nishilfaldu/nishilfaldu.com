# Sediment: optional override for the download CTA.
# Leave unset to use the default App Store URL.
NEXT_PUBLIC_SEDIMENT_DOWNLOAD_URL=

# Cooking (WIP previews) — set on Vercel / .env.local, never commit real values.
# Prefer a fine-grained GITHUB_TOKEN scoped to the repos you want Cooking to
# watch (e.g. this site, sediment, native-harbor, volt). The API lists whatever
# the token can read — no hardcoded allowlist in the app. Optional try-mode
# overrides (preview vs release) live in lib/cooking/repos.ts.
# Preview URLs come from GitHub Deployments (no Vercel API).
GITHUB_TOKEN=

# Cloud agent launcher (owner-only bottom-right “agent” control).
# CURSOR_API_KEY — Cursor Dashboard → API Keys (server-only).
# AGENT_ACCESS_SECRET — unlock code. Visit once:
#   /api/agent/unlock?code=AGENT_ACCESS_SECRET
# That sets a 30-day httpOnly cookie; the button only mounts when present.
CURSOR_API_KEY=
AGENT_ACCESS_SECRET=

# Reading list (/reading). Its own Convex deployment — separate from Sediment's,
# which the download CTA above still points at. `npx convex dev` writes the two
# NEXT_PUBLIC_ values itself; don't set them by hand.
#
# KEEPS_WRITE_SECRET is the one you set: the same value must exist here (or on
# Vercel) and on the Convex deployment via `npx convex env set`. The deployment
# URL is public, so this secret — not the URL — is what stops a stranger from
# writing to the table. It never reaches the browser.
NEXT_PUBLIC_CONVEX_URL=
KEEPS_WRITE_SECRET=
