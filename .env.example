# Cloud agent launcher (owner-only bottom-right “agent” control).
# CURSOR_API_KEY — Cursor Dashboard → API Keys (server-only).
# AGENT_ACCESS_SECRET — unlock code. Visit once:
#   /api/agent/unlock?code=AGENT_ACCESS_SECRET
# That sets a 30-day httpOnly cookie; the button only mounts when present.
CURSOR_API_KEY=
AGENT_ACCESS_SECRET=

# Reading list (/reading). Its own Convex deployment — separate from Sediment's.
# `npx convex dev` writes the two NEXT_PUBLIC_ values itself; don't set them by
# hand.
#
# KEEPS_WRITE_SECRET is the one you set: the same value must exist here (or on
# Vercel) and on the Convex deployment via `npx convex env set`. The deployment
# URL is public, so this secret — not the URL — is what stops a stranger from
# writing to the table. It never reaches the browser.
NEXT_PUBLIC_CONVEX_URL=
KEEPS_WRITE_SECRET=
